# Copy this file to .env.local and fill in your actual values.

# Supabase — find these under: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY - never expose this to the browser. Used only in app/api/* routes
# for admin actions (creating/deleting student accounts, granting enrollments).
# Find it under: Settings -> API -> Project API keys -> service_role (click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live site URL (no trailing slash). Used to build invite/reset-password
# links and the Paystack payment return URL. For local development this can
# stay as http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack — find these under: Paystack Dashboard -> Settings -> API Keys & Webhooks
# SERVER-ONLY - never expose the secret key to the browser.
PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# WhatsApp community group invite link
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-group-invite-code
